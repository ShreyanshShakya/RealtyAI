# OpenRouter (required for Phase 3+)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=openrouter/free

# Scraping (optional overrides)
REQUEST_TIMEOUT=30
REQUEST_DELAY=1.5
REQUEST_JITTER=0.5
MAX_RETRIES=3
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Paths
RAW_DATA_DIR=dataset/raw
PROCESSED_DATA_DIR=dataset/processed
REJECTED_DATA_DIR=dataset/rejected
CHROMA_DB_PATH=dataset/chroma_db
COLLECTION_NAME=realty_properties