dataset/raw/
dataset/rejected/
dataset/excluded/

# Keep the processed RAG-ready dataset in the image.
dataset/processed/*
!dataset/processed/darglobal_rag_ready.jsonl

# Keep README, but omit other documentation from image context.
*.md
!README.md
