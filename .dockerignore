# Git and tooling
.git
.gitignore
.github/
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Secrets and local state
.env
.env.*
